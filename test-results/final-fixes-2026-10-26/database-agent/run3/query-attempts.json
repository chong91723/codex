      "query": "SELECT\n    s.store_id,\n    SUM(p.amount) AS amount_total,\n    COUNT(p.payment_id) AS payment_count\nFROM payment AS p\nJOIN staff AS s\n    ON s.staff_id = p.staff_id\nWHERE p.payment_date >= '2005-07-01 00:00:00'\n  AND p.payment_date <  '2005-08-01 00:00:00'\n  AND s.store_id = 1\nGROUP BY s.store_id\nORDER BY s.store_id ASC;"
