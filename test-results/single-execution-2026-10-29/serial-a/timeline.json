    "kind": "A-offline-query-close-trigger",
    "data": {
      "item": {
        "type": "mcpToolCall",
        "id": "call_00_zheriidPFI1N895U7V1c0599",
        "server": "codex_web_databases",
        "tool": "query_database",
        "status": "inProgress",
        "arguments": {
          "connection_id": "36390c697136fae83168e7fb",
          "query": "SELECT\n    YEAR(h.OrderDate) AS sales_year,\n    COALESCE(pc.Name, '未分类') AS product_category,\n    SUM(d.LineTotal) AS net_sales,\n    COUNT(*) AS line_count,\n    COUNT(DISTINCT h.SalesOrderID) AS order_count\nFROM salesorderdetail AS d\nJOIN salesorderheader AS h\n    ON h.SalesOrderID = d.SalesOrderID\nLEFT JOIN product AS p\n    ON p.ProductID = d.ProductID\nLEFT JOIN productsubcategory AS ps\n    ON ps.ProductSubcategoryID = p.ProductSubcategoryID\nLEFT JOIN productcategory AS pc\n    ON pc.ProductCategoryID = ps.ProductCategoryID\nWHERE h.OrderDate >= '2002-01-01'\n  AND h.OrderDate < '2004-01-01'\nGROUP BY\n    YEAR(h.OrderDate),\n    COALESCE(pc.Name, '未分类')\nORDER BY\n    sales_year,\n    net_sales DESC;"
        },
        "appContext": null,
